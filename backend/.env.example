# QuantLab Backend Configuration

# Cache settings
CACHE_TTL_SECONDS=300

# Database
DATABASE_URL=backend/data/cache.db

# Data provider (yfinance, tradier, polygon, etc.)
DATA_PROVIDER=yfinance

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Risk-free interest rate (annual, decimal)
RISK_FREE_RATE=0.05
